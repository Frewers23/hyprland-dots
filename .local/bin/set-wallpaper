#!/usr/bin/env bash

if [ -z "$1" ]; then
    echo "Usage: set-wallpaper /path/to/image.jpg"
    exit 1
fi

IMAGE="$(realpath "$1")"

# 1. Update hyprpaper.conf for persistence
cat << HP > ~/.config/hypr/hyprpaper.conf
preload = $IMAGE
wallpaper = ,$IMAGE
HP

# 2. Set wallpaper live with hyprpaper
if ! pgrep hyprpaper > /dev/null; then
    hyprpaper &
    sleep 1
else
    hyprctl hyprpaper preload "$IMAGE"
    for mon in $(hyprctl monitors -j | jq -r '.[].name'); do
        hyprctl hyprpaper wallpaper "$mon,$IMAGE"
    done
fi

# 3. Generate colors with matugen (Material Design 3)
mkdir -p ~/.cache
~/.local/bin/matugen image "$IMAGE" --source-color-index 0 -j hex > ~/.cache/matugen_colors.json

# 4. Update Quickshell colors using matugen output
python3 ~/.config/quickshell/update_colors.py
killall quickshell || true
quickshell &

# 5. Generate Rofi colors
cat << ROFI > ~/.config/rofi/colors.rasi
* {
    background: $(cat ~/.cache/matugen_colors.json | jq -r '.colors.surface')e6;
    foreground: $(cat ~/.cache/matugen_colors.json | jq -r '.colors.on_surface');
    primary: $(cat ~/.cache/matugen_colors.json | jq -r '.colors.primary');
    surface-container: $(cat ~/.cache/matugen_colors.json | jq -r '.colors.surface_container')d0;
    surface-variant: $(cat ~/.cache/matugen_colors.json | jq -r '.colors.surface_variant')d0;
}
ROFI

echo "Done! Wallpaper and colors updated with Material You."
