#!/usr/bin/env python3
import sys
import os
import base64
import json
import requests

if len(sys.argv) < 2:
    print("Użycie: dlc-decrypt <plik.dlc>", file=sys.stderr)
    sys.exit(1)

dlc_path = sys.argv[1]

if not os.path.exists(dlc_path):
    print(f"Błąd: Plik '{dlc_path}' nie istnieje.", file=sys.stderr)
    sys.exit(1)

# Serwer dekodujący z poprawną strukturą payloadu
url = "https://dcrypt.it/decrypt/paste"

try:
    with open(dlc_path, "rb") as f:
        # Przekazujemy plik dokładnie tak, jak oczekuje tego interfejs webowy
        files = {"dlcfile": (os.path.basename(dlc_path), f, "application/octet-stream")}
        response = requests.post(url, files=files, headers={"User-Agent": "Mozilla/5.0"}, timeout=15)

    if response.status_code == 200:
        try:
            # Sprawdzamy czy odpowiedź zawiera linki w formacie JSON
            data = response.json()
            links = data.get("success", {}).get("links", [])
            if links:
                for link in links:
                    print(link)
                sys.exit(0)
        except json.JSONDecodeError:
            pass

    # Zapasowe zapytanie przez czysty tekst
    with open(dlc_path, "r", encoding="utf-8", errors="ignore") as f:
        content = f.read().strip()

    response = requests.post(url, data={"content": content}, headers={"User-Agent": "Mozilla/5.0"}, timeout=15)
    data = response.json()
    links = data.get("success", {}).get("links", [])

    if links:
        for link in links:
            print(link)
    else:
        print("Błąd: Nie udało się wyciągnąć linków z tego pliku DLC.", file=sys.stderr)
        sys.exit(1)

except Exception as e:
    print(f"Wystąpił błąd podczas dekodowania: {e}", file=sys.stderr)
    sys.exit(1)
